            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          },
          {
            "name": "includePointsOfInterest",
            "in": "query",
            "description": "Include points of interest yes or no?",
            "schema": {
              "type": "boolean",
              "default": false
